.ftr-col-01 .iti {
  width: 100%;
}
</style>
<script src="https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/intlTelInput.min.js"></script>
<script>
(function() {
  function initFooterCountryCode() {
    if (!window.intlTelInput) {
      setTimeout(initFooterCountryCode, 100);
      return;
    }

    document.querySelectorAll('.ftr-col-01 input[type="tel"]').forEach(function(input) {
      if (input.dataset.intlTelReady || input.closest('.iti')) {
        return;
      }

      input.dataset.intlTelReady = '1';
      window.intlTelInput(input, {
        initialCountry: "in",
        separateDialCode: true,
        preferredCountries: ["in", "ae", "us"],
        utilsScript: "https://cdnjs.cloudflare.com/ajax/libs/intl-tel-input/17.0.19/js/utils.js"
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterCountryCode);
  } else {
    initFooterCountryCode();
  }
  window.addEventListener('load', initFooterCountryCode);
})();
</script>





